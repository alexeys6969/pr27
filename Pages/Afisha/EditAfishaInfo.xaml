<Page x:Class="Cinema_Shashin.Pages.Afisha.EditAfishaInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cinema_Shashin.Pages.Afisha"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditAfishaInfo" Background="White">

    <Grid>
        <Grid VerticalAlignment="Top" Background="LightGoldenrodYellow">
            <Label Content="Изменить информацию об афише" x:Name="mainLabel" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,10"/>
        </Grid>
        <Grid VerticalAlignment="Stretch" Margin="0,65,0,0">
            <ScrollViewer>
                <StackPanel x:Name="parent">
                    <TextBlock Text="Кинотеатр:" x:Name="cinemaName" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,10,0,0"/>
                    <TextBlock Text="Фильм:" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,20,0,0"/>
                    <TextBox x:Name="movieTb" HorizontalAlignment="Stretch" Margin="15,20,15,0" Height="25"/>
                    <TextBlock Text="Дата сеанса:" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,20,0,0"/>
                    <DatePicker x:Name="dateSeans" HorizontalAlignment="Stretch" Margin="15,20,15,0" Height="25"/>
                    <TextBlock Text="Время сеанса:" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,20,0,0"/>
                    <xctk:TimePicker x:Name="timeSeans" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Margin="15,20,15,0" Height="25"/>
                    <TextBlock Text="Цена:" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,20,0,0"/>
                    <TextBox x:Name="priceTb" HorizontalAlignment="Stretch" Margin="15,20,15,0" Height="25"/>
                    <Button Content="Обновить афишу" x:Name="editBtn" Click="editAfisha" Foreground="White" HorizontalAlignment="Stretch" Margin="15,20,15,0" Height="25" BorderThickness="0" Background="MediumSeaGreen"/>
                    <Button Content="Назад" Click="exit" Foreground="White" HorizontalAlignment="Stretch" Margin="15,20,15,10" Height="25" BorderThickness="0" Background="Black"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
