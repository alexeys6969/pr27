<Page x:Class="Cinema_Shashin.Pages.Afisha.Afishas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cinema_Shashin.Pages.Afisha"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Afishas" Background="White">

    <Grid>
        <Grid VerticalAlignment="Top" Background="LightGoldenrodYellow">
            <Label Content="Афиша кинотеатра " x:Name="cinemaLabel" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,10"/>
            <Button Content="Вернуться" Click="exit" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Left" Margin="10,0,0,0" Background="MediumSeaGreen" BorderThickness="0"/>
        </Grid>
        <Grid VerticalAlignment="Stretch" Margin="0,65,0,0">
            <ScrollViewer>
                <StackPanel x:Name="parent">

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
